<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FlowerShop.Maui.Pages.ForgotPasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFF8F9">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid BackgroundColor="#C2185B" Padding="16,12"
                  ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="←"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        FontSize="22"
                        Clicked="OnBackTapped" />
                <Label Grid.Column="1"
                       Text="🌸 FlowerShop"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Padding="24" Spacing="24">

                <Label Text="Şifremi Unuttum 🔑"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#C2185B"
                       HorizontalOptions="Center" />

                <Label Text="E-posta adresinizi ve yeni şifrenizi girin"
                       FontSize="14"
                       TextColor="#888"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Frame BackgroundColor="White"
                       CornerRadius="20"
                       BorderColor="#F8BBD9"
                       HasShadow="True"
                       Padding="24">
                    <VerticalStackLayout Spacing="16">

                        <!-- Email -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="E-posta *"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#C2185B" />
                            <Frame x:Name="EmailBorder"
                                   Padding="12,0"
                                   CornerRadius="12"
                                   BorderColor="#F8BBD9"
                                   BackgroundColor="#FFF8F9"
                                   HasShadow="False"
                                   HeightRequest="48">
                                <Entry x:Name="EmailEntry"
                                       Placeholder="ornek@email.com"
                                       Keyboard="Email"
                                       TextColor="#333"
                                       PlaceholderColor="#CCC"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                            </Frame>
                        </VerticalStackLayout>

                        <!-- New Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Yeni Şifre *"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#C2185B" />
                            <Frame x:Name="NewPasswordBorder"
                                   Padding="12,0"
                                   CornerRadius="12"
                                   BorderColor="#F8BBD9"
                                   BackgroundColor="#FFF8F9"
                                   HasShadow="False"
                                   HeightRequest="48">
                                <Entry x:Name="NewPasswordEntry"
                                       Placeholder="En az 6 karakter"
                                       IsPassword="True"
                                       TextColor="#333"
                                       PlaceholderColor="#CCC"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Confirm Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Yeni Şifre Tekrar *"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#C2185B" />
                            <Frame x:Name="ConfirmPasswordBorder"
                                   Padding="12,0"
                                   CornerRadius="12"
                                   BorderColor="#F8BBD9"
                                   BackgroundColor="#FFF8F9"
                                   HasShadow="False"
                                   HeightRequest="48">
                                <Entry x:Name="ConfirmPasswordEntry"
                                       Placeholder="Şifreyi tekrar girin"
                                       IsPassword="True"
                                       TextColor="#333"
                                       PlaceholderColor="#CCC"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Message -->
                        <Label x:Name="MessageLabel"
                               IsVisible="False"
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <!-- Button -->
                        <Button Text="Şifremi Sıfırla 🔑"
                                BackgroundColor="#C2185B"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="50"
                                FontAttributes="Bold"
                                FontSize="16"
                                Clicked="OnResetPasswordClicked" />

                        <!-- Back to Login -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="Şifrenizi hatırladınız mı?"
                                   FontSize="13"
                                   TextColor="#888"
                                   VerticalOptions="Center" />
                            <Label Text="Giriş Yap"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#C2185B"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLoginTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>