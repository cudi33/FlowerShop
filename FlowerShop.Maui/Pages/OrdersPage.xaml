<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="FlowerShop.Maui.Pages.OrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FFF8F9">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#C2185B"
              Padding="16"
              ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Text="←"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    FontSize="22"
                    Clicked="OnBackTapped" />
            <Label Grid.Column="1"
                   Text="Siparişlerim 🌸"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="12">

                <!-- Loading -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#C2185B"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0" />

                <!-- Empty Message -->
                <VerticalStackLayout x:Name="EmptyView"
                                     IsVisible="False"
                                     HorizontalOptions="Center"
                                     Spacing="8"
                                     Margin="0,60,0,0">
                    <Label Text="🌷" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Henüz siparişiniz yok"
                           FontSize="18"
                           TextColor="#C2185B"
                           HorizontalOptions="Center" />
                    <Button Text="Ürünlere Göz At"
                            BackgroundColor="#C2185B"
                            TextColor="White"
                            CornerRadius="20"
                            Padding="20,10"
                            Clicked="OnBrowseProductsTapped" />
                </VerticalStackLayout>

                <!-- Orders CollectionView -->
                <CollectionView x:Name="OrdersCollection"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4"
                                    Padding="16"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F8BBD9">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="6">

                                    <!-- Product Name -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding ProductName}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#333" />

                                    <!-- Status Badge -->
                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="8,4"
                                            BackgroundColor="#FCE4EC"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="#F8BBD9">
                                        <Label Text="{Binding Status}"
                                               FontSize="12"
                                               TextColor="#C2185B" />
                                    </Border>

                                    <!-- Total Price -->
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           FontSize="14"
                                           TextColor="#666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Toplam: " FontAttributes="Bold" />
                                                <Span Text="{Binding TotalPrice, StringFormat='{0:F2} ₺'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Delivery Date -->
                                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                                           FontSize="13"
                                           TextColor="#888">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="📅 Teslimat: " />
                                                <Span Text="{Binding DeliveryDate, StringFormat='{0:dd/MM/yyyy}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Payment Info -->
                                    <Label Grid.Row="3" Grid.ColumnSpan="2"
                                           FontSize="12"
                                           TextColor="#666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="💳 Ödeme: " FontAttributes="Bold" />
                                                <Span Text="{Binding PaymentMethod}" />
                                                <Span Text=" — " />
                                                <Span Text="{Binding PaymentStatus}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Surprise Badge -->
                                    <Label Grid.Row="4" Grid.ColumnSpan="2"
                                           Text="🎁 Sürpriz Sipariş"
                                           FontSize="12"
                                           TextColor="#E91E63"
                                           IsVisible="{Binding IsSurprise}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>