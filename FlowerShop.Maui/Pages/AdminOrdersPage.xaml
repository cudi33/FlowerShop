<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="FlowerShop.Maui.Pages.AdminOrdersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FFF8F9">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#C2185B"
              Padding="16"
              ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Text="←"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    FontSize="22"
                    Clicked="OnBackTapped" />
            <Label Grid.Column="1"
                   Text="Tüm Siparişler 🌸"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="12">

                <!-- Loading -->
                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#C2185B"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0" />

                <!-- Empty -->
                <VerticalStackLayout x:Name="EmptyView"
                                     IsVisible="False"
                                     HorizontalOptions="Center"
                                     Spacing="8"
                                     Margin="0,60,0,0">
                    <Label Text="🌷" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="Henüz sipariş yok"
                           FontSize="18"
                           TextColor="#C2185B"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Orders -->
                <CollectionView x:Name="OrdersCollection" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4"
                                    Padding="16"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="#F8BBD9">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="6">

                                    <!-- Order ID + Status -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#333">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Sipariş #" />
                                                <Span Text="{Binding Id}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <Border Grid.Row="0" Grid.Column="1"
                                            Padding="8,4"
                                            BackgroundColor="#FCE4EC"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="#F8BBD9">
                                        <Label Text="{Binding Status}"
                                               FontSize="12"
                                               TextColor="#C2185B" />
                                    </Border>

                                    <!-- User -->
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           FontSize="13"
                                           TextColor="#666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="👤 " />
                                                <Span Text="{Binding UserName}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Product + Price -->
                                    <Label Grid.Row="2" Grid.ColumnSpan="2"
                                           FontSize="13"
                                           TextColor="#666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="🌸 " />
                                                <Span Text="{Binding ProductName}" />
                                                <Span Text="   |   " />
                                                <Span Text="{Binding TotalPrice, StringFormat='{0:F2} ₺'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Delivery Date -->
                                    <Label Grid.Row="3" Grid.ColumnSpan="2"
                                           FontSize="13"
                                           TextColor="#888">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="📅 " />
                                                <Span Text="{Binding DeliveryDate, StringFormat='{0:dd/MM/yyyy}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <!-- Surprise + Payment + Update Button -->
                                    <VerticalStackLayout Grid.Row="4" Grid.ColumnSpan="2" Spacing="6">

                                        <Label Text="🎁 Sürpriz Sipariş"
                                               FontSize="12"
                                               TextColor="#E91E63"
                                               IsVisible="{Binding IsSurprise}" />

                                        <Label FontSize="12" TextColor="#666">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="💳 Ödeme: " FontAttributes="Bold" />
                                                    <Span Text="{Binding PaymentMethod}" />
                                                    <Span Text=" — " />
                                                    <Span Text="{Binding PaymentStatus}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <Button Text="🔄 Durumu Güncelle"
                                                BackgroundColor="#C2185B"
                                                TextColor="White"
                                                FontSize="12"
                                                CornerRadius="8"
                                                Padding="12,6"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnUpdateStatusTapped" />

                                    </VerticalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>