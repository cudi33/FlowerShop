<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="FlowerShop.Maui.Popups.ProductDetailPopup"
    CanBeDismissedByTappingOutsideOfPopup="True"
    Color="Transparent">

    <Border BackgroundColor="White"
            StrokeShape="RoundRectangle 20"
            Stroke="#F8BBD9"
            Padding="0"
            WidthRequest="340">
        <VerticalStackLayout Spacing="0">

            <!-- صورة المنتج -->
            <Grid HeightRequest="200" BackgroundColor="#FCE4EC">
                <Image x:Name="ProductImage"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill" />
                <Label Text="🌸"
                       FontSize="60"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       ZIndex="-1" />

                <!-- زر إغلاق -->
                <Button Text="✕"
                        BackgroundColor="#00000044"
                        TextColor="White"
                        CornerRadius="20"
                        WidthRequest="36"
                        HeightRequest="36"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,10,10,0"
                        Clicked="OnCloseClicked" />
            </Grid>

            <!-- التفاصيل -->
            <VerticalStackLayout Padding="20" Spacing="10">

                <Label x:Name="ProductNameLabel"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#333" />

                <Label x:Name="CategoryLabel"
                       FontSize="13"
                       TextColor="#C2185B" />

                <Label x:Name="PriceLabel"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#AD1457" />

                <Label x:Name="StockLabel"
                       FontSize="13"
                       TextColor="#888" />

                <!-- خط فاصل -->
                <BoxView HeightRequest="1"
                         BackgroundColor="#F8BBD9"
                         Margin="0,4" />

                <!-- أزرار -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="İptal"
                            BackgroundColor="#F3E5F5"
                            TextColor="#C2185B"
                            CornerRadius="12"
                            HeightRequest="46"
                            Clicked="OnCloseClicked" />
                    <Button Grid.Column="1"
                            Text="🛍️ Sipariş Ver"
                            BackgroundColor="#C2185B"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="46"
                            FontAttributes="Bold"
                            Clicked="OnOrderClicked" />
                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>