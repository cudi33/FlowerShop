<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="FlowerShop.Maui.Pages.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#FFF8F9">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#C2185B"
              Padding="16"
              ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Text="←"
                    TextColor="White"
                    BackgroundColor="Transparent"
                    FontSize="22"
                    Clicked="OnBackTapped" />
            <Label Grid.Column="1"
                   Text="Şifre Değiştir 🌸"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Grid>
        <!-- Form -->
        <ScrollView Grid.Row="1" Padding="24">
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="500"
                                 HorizontalOptions="Center">

                <Label Text="Mevcut Şifre"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#C2185B" />
                <Border x:Name="OldPasswordBorder"
                        Stroke="#F8BBD9"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        Padding="4,0">
                    <Entry x:Name="OldPasswordEntry"
                           Placeholder="Mevcut şifrenizi girin"
                           TextColor="Black"
                           IsPassword="True"
                           FontSize="15"
                           Margin="8,0" />
                </Border>

                <Label Text="Yeni Şifre"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#C2185B" />
                <Border x:Name="NewPasswordBorder"
                        Stroke="#F8BBD9"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        Padding="4,0">
                    <Entry x:Name="NewPasswordEntry"
                           Placeholder="En az 6 karakter"
                            TextColor="Black"
                           IsPassword="True"
                           FontSize="15"
                           Margin="8,0" />
                </Border>

                <Label Text="Yeni Şifre (Tekrar)"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#C2185B" />
                <Border x:Name="ConfirmPasswordBorder"
                        Stroke="#F8BBD9"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        Padding="4,0">
                    <Entry x:Name="ConfirmPasswordEntry"
                           Placeholder="Yeni şifreyi tekrar girin"
                            TextColor="Black"
                           IsPassword="True"
                           FontSize="15"
                           Margin="8,0" />
                </Border>

                <!-- Error Message -->
                <Label x:Name="MessageLabel"
                       IsVisible="False"
                       FontSize="13"
                       HorizontalOptions="Center" />

                <!-- Submit Button -->
                <Button x:Name="SubmitButton"
                        Text="Şifreyi Güncelle"
                        BackgroundColor="#C2185B"
                        TextColor="White"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HeightRequest="52"
                        Clicked="OnChangePasswordClicked"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>